{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "app/api/**/*.ts": { "runtime": "nodejs20.x", "maxDuration": 10, "memory": 1024 },
    "app/api/**/*.js": { "runtime": "nodejs20.x", "maxDuration": 10, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/app/api/$1" }
  ],
  "cleanUrls": true
}
