###############################################
# WORKER SESSION-NODE (.env.example)
# Copie para .env.local ou .env e preencha valores reais.
###############################################

# ===== SUPABASE =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=anon-key-here                # Opcional para algumas leituras; não crítico
SUPABASE_SERVICE_ROLE=service-role-key-here    # NECESSÁRIO para atualizar whatsapp_sessions.last_qr sob RLS
SESSION_STORAGE_BUCKET=sessions

# ===== FILA (pg-boss) =====
QUEUE_DB_URL=postgresql://user:password@host:5432/postgres   # Igual ao do app

# ===== INBOUND (para enviar mensagens recebidas ao backend) =====
INBOUND_URL=https://seu-app.vercel.app/api/inbound
INBOUND_TOKEN=internal-webhook-secret          # Mesmo valor configurado no app

# ===== IA (se o worker também gerar respostas) =====
OPENAI_API_KEY=

# ===== LOG / PERFORMANCE =====
LOG_LEVEL=info
MAX_SESSIONS_PER_NODE=50
SESSION_ENCRYPTION_KEY=base64-or-hex-32bytes   # Opcional para criptografia do estado

# ===== DIVERSOS =====
PORT=4000                                      # Se expor HTTP local (não obrigatório em Vercel cron/container)

# Notas:
# - Este worker não deve servir o frontend. Não usar seu domínio como API_BASE.
# - Garantir que QUEUE_DB_URL aponte para o mesmo Postgres onde o app publica jobs session:start.
# - Se o QR não aparecer: verificar logs aqui e conferir se há update em whatsapp_sessions.last_qr.
