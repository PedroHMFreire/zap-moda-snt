###############################################
# ENV EXAMPLE (não colocar segredos reais aqui)
# Copie para .env.local e preencha valores reais.
###############################################

# ===== API (Vercel) =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_ROLE=service-role-key-here   # NÃO usar no front-end
QUEUE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres  # ajustar, evite caracteres especiais sem URL encode
OPENAI_API_KEY=sk-EXAMPLE_REPLACE_ME
INTERNAL_WEBHOOK_TOKEN=internal-webhook-secret
INTERNAL_METRICS_TOKEN=metrics-secret
SESSION_STORAGE_BUCKET=sessions

# Opcional (defaults no código)
LOG_LEVEL=info
AI_MIN_INTERVAL_MS=15000
AI_MAX_MESSAGES=16
AI_MAX_CONTEXT_CHARS=4000
CACHE_DEFAULT_TTL_MS=5000
CACHE_PRODUCT_SEARCH_TTL_MS=30000

# ===== Worker (session-node) =====
# Ajustar INBOUND_URL após primeiro deploy Vercel
INBOUND_URL=http://localhost:3000/api/inbound
INBOUND_TOKEN=internal-webhook-secret   # igual ao INTERNAL_WEBHOOK_TOKEN
MAX_SESSIONS_PER_NODE=50
SESSION_ENCRYPTION_KEY=base64-or-hex-32bytes   # opcional para criptografia de sessões
PORT=4000

# ===== Notas =====
# 1. Coloque valores reais em .env.local (não versionado).
# 2. Configure as mesmas variáveis no painel da Vercel.
# 3. Rotacione chaves se algum segredo vazar.
# 4. OPENAI_API_KEY pode ser omitido se IA ainda não estiver ativa.
