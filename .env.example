###############################################
# EXEMPLO DE VARIÁVEIS (.env.example)
# Copie para .env.local (dev) e preencha valores reais.
# No deploy (Vercel), cadastre as mesmas chaves em Settings → Environment Variables.
# MODELO: user = workspace (não existe mais store_id).
###############################################

# ======== SUPABASE (OBRIGATÓRIO) =========
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=anon-key-here                   # Chave pública (pode ir para o front/get /api/config)
SUPABASE_SERVICE_ROLE=service-role-key-here       # NÃO expor no navegador. Usado no backend/worker.
SESSION_STORAGE_BUCKET=sessions                   # Bucket onde estado de sessão WhatsApp será salvo

# ======== FILA / PG-BOSS =========
QUEUE_DB_URL=postgresql://user:password@host:5432/postgres   # Mesma URL vista pelo worker e pelo app

# ======== IA (Opcional) =========
OPENAI_API_KEY=sk-EXAMPLE_REPLACE_ME
AI_MIN_INTERVAL_MS=15000          # Respeita intervalo mínimo entre respostas automáticas
AI_MAX_MESSAGES=16                # Limite de mensagens recentes para contexto
AI_MAX_CONTEXT_CHARS=4000         # Corte de contexto

# ======== LOG / CACHE (Opcional) =========
LOG_LEVEL=info
CACHE_DEFAULT_TTL_MS=5000
CACHE_PRODUCT_SEARCH_TTL_MS=30000

# ======== INBOUND / WEBHOOK interno =========
INBOUND_URL=http://localhost:3000/api/inbound     # URL interna que o worker usa para postar mensagens recebidas
INBOUND_TOKEN=internal-webhook-secret             # Segredo HMAC compartilhado app <-> worker

# ======== OBSERVABILIDADE (Opcional) =========
INTERNAL_METRICS_TOKEN=metrics-secret

# ======== WORKER (Extras) =========
MAX_SESSIONS_PER_NODE=50
SESSION_ENCRYPTION_KEY=base64-or-hex-32bytes      # Opcional, para criptografar estado de sessão
PORT=4000                                         # Se o worker expõe algo HTTP local

# ======== PUBLIC API BASE (Frontend) =========
# Se o frontend (index.html) estiver servido no MESMO domínio das rotas /api, deixe em branco.
# Se estiver em domínio separado (ex: static CDN), defina para apontar para o domínio da API.
PUBLIC_API_BASE=

# ======== NOTAS RÁPIDAS =========
# 1. Nunca coloque SUPABASE_SERVICE_ROLE exposta no browser.
# 2. O worker precisa de SUPABASE_SERVICE_ROLE para atualizar whatsapp_sessions sob RLS.
# 3. API_BASE no front = PUBLIC_API_BASE (via /api/config), ou vazio se mesmo domínio.
# 4. Ajuste QUEUE_DB_URL igual para app e worker (compartilham a mesma fila pg-boss).
# 5. Rotacione OPENAI_API_KEY e INBOUND_TOKEN se houver suspeita de vazamento.

